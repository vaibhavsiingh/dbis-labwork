<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Student Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
        }

        .container {
            width: 900px;
            margin: 40px auto;
            background: white;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        table {
            width:100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th,td {
            border: 1px solid #ddd;
            padding: 8px ; 
            text-align: left;   
        }

        th {
           background-color: #f0f0f0;
        }

        button {
            padding: 4px 8px;
            cursor: pointer; 
        }

        #error-box {
            margin: 10px 0;
            color: red;
            display: none
        }

        #success-box {
            margin: 10px 0;
            color: green;
                        
            display: none;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Student Dashboard</h1>
        <a href="/logout">Logout</a>

        <hr>

        <div id="error-box"></div>
        <div id="success-box"></div>

        <h2>My Registered Courses</h2>
        Total Credits: <%= totalCredits %>

        <table>
            <tr>
                <th>Course ID</th>
                <th>Name</th>
                <th>Credits</th>
                <th>Slot</th>
                <th>Action</th>
            </tr>
            <% registered_courses.forEach(course => { %>
                <tr>
                    <td><%= course.course_id %></td>
                    <td><%= course.course_name %></td>
                    <td><%= course.credits %></td>
                    <td><%= course.slot %></td>
                    <td>
                        <button onclick="dropCourse('<%= course.course_id %>')">Drop</button>
                    </td>
                </tr>
            <% }) %>
        </table>

        <h2>Available Courses</h2>

        <table>
            <tr>
                <th>Course ID</th>
                <th>Name</th>
                <th>Credits</th>
                <th>Slot</th>
                <th>Capacity</th>
                <th>Action</th>
            </tr>
            <% available_courses.forEach(course => { %>
                <tr>
                    <td><%= course.course_id %></td>
                    <td><%= course.course_name %></td>
                    <td><%= course.credits %></td>
                    <td><%= course.slot %></td>
                    <td><%= course.capacity %></td>
                    <td>
                        <button onclick="registerCourse('<%= course.course_id %>')">Register</button>
                    </td>
                </tr>
            <% }) %>
        </table>
    </div>
</body>

<script>
    function showError(msg) {
        const box = document.getElementById('error-box');
        box.innerText = msg;
        box.style.display = 'block';
    }

    function showSuccess(msg) {
        const box = document.getElementById('success-box');
        box.innerText = msg;
        box.style.display = 'block';

    }

    async function dropCourse(courseId){
        try {
            const res = await fetch('/student/drop', {
                method:'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({course_id: courseId})
            });
            const data = await res.json();
            if (!res.ok) {
                showError(data.message);
                return;
            }
            sessionStorage.setItem("successMessage", data.message);
            location.reload();
        } catch (err){
            showError("Network Error.");
        }
    }

    async function registerCourse(courseId){
        try {
            const res = await fetch('/student/register', {
                method:'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({course_id: courseId})
            });
            const data = await res.json();
            if (!res.ok) {
                showError(data.message);
                return;
            }
            sessionStorage.setItem("successMessage", data.message);
            location.reload();
            
        } catch (err){
            showError("Network Error");
        }
    }

    window.onload = () => {
        const msg = sessionStorage.getItem("successMessage");
        if (msg) {
            showSuccess(msg);
            sessionStorage.removeItem("successMessage");
        }
    };
</script>

</html>
