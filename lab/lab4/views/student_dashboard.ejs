<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Student Dashboard</title>
</head>

<body>
    <h1>Student Dashboard</h1>
    <a href="/logout">Logout</a>

    <hr>

    <!-- TODO: Display Registered Courses -->
    <!-- Show: Course ID, Name, Credits, Slot -->
    <!-- Action: Drop Button -->
    <h2>My Registered Courses</h2>
    Total Credits: <%= totalCredits %> <br>
    <ul>
        <% registered_courses.forEach(course =>{ %>
            <li><%= course.course_id %>, <%= course.course_name %>, <%= course.credits %>, <%= course.slot %></li>
        <%})%>
    </ul>

    <!-- TODO: Display Available Courses -->
    <!-- Show: Course ID, Name, Credits, Slot, Capacity -->
    <!-- Action: Register Button -->
    <h2>Available Courses</h2>
    <ul>
        <% available_courses.forEach(course =>{ %>
            <li><%= course.course_id %>, <%= course.course_name %>, <%= course.credits %>, <%= course.slot %>, <%= course.capacity %></li>
        <%})%>
    </ul>    
</body>

</html>