<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Student Dashboard</title>
</head>

<body>
    <h1>Student Dashboard</h1>
    <a href="/logout">Logout</a>

    <hr>

    <!-- TODO: Display Registered Courses -->
    <!-- Show: Course ID, Name, Credits, Slot -->
    <!-- Action: Drop Button -->
    <h2>My Registered Courses</h2>
    Total Credits: <%= totalCredits %> <br>
    <ul>
        <% registered_courses.forEach(course =>{ %>
            <li><%= course.course_id %>, <%= course.course_name %>, <%= course.credits %>, <%= course.slot %>
                <button onclick="dropCourse('<%= course.course_id %>')">Drop</button>
            </li>
        <%})%>
    </ul>

    <!-- TODO: Display Available Courses -->
    <!-- Show: Course ID, Name, Credits, Slot, Capacity -->
    <!-- Action: Register Button -->
    <h2>Available Courses</h2>
    <ul>
        <% available_courses.forEach(course =>{ %>
            <li><%= course.course_id %>, <%= course.course_name %>, <%= course.credits %>, <%= course.slot %>, <%= course.capacity %>
                <button onclick="registerCourse('<%= course.course_id %>')">Register</button>
            </li>
        <%})%>
    </ul>    
</body>

<script>
    async function dropCourse(courseId){
        try {
            const res = await fetch('/student/drop', {
                method:'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({course_id: courseId})
            });

            if(!res.ok){
                throw new Error('Request Failed');
            }

            location.reload();
        } catch (err){
            console.error(err);
            alert('Failed to drop course');
        }

    }

    async function registerCourse(courseId){
        try {
            const res = await fetch('/student/register', {
                method:'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({course_id: courseId})
            });
            
            if(!res.ok){
                throw new Error('Request Failed');
            }
            
            location.reload();
            // alert('Tryin to register course');
        } catch (err){
            console.error(err);
            alert('Failed to register course');
        }

    }
</script>

</html>