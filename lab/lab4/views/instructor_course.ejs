<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Course Details</title>
</head>

<body>
    <h1>Manage Course</h1>
    <a href="/instructor/dashboard">Back to Dashboard</a>

    <hr>

    <!-- Add Student -->
    <h3>Add Student</h3>
    <form onsubmit="addStudent(event)">
        <label>Enter Student Username</label>
        <input type="text" id="student_input" required>
        <button type="submit">Add Student</button>
    </form>

    <hr>

    <!-- Enrolled Students -->
    <h3>Enrolled Students</h3>
    <ul>
        <% if (student_info.length === 0) { %>
            <li>No students enrolled.</li>
        <% } %>

        <% student_info.forEach(student => { %>
            <li>
                <%= student.student_id %>,
                <%= student.username %>,
                <%= student.full_name %>
                <button onclick="removeStudent('<%= student.username %>', '<%= course_id %>')">
                    Remove
                </button>
            </li>
        <% }) %>
    </ul>

</body>

<script>
    async function removeStudent(username, courseId) {
        try {
            const res = await fetch('/instructor/remove-student', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    username: username,
                    course_id: courseId
                })
            });

            if (!res.ok) {
                throw new Error('Request Failed');
            }

            location.reload();
        } catch (err) {
            console.error(err);
            alert('Failed to remove student');
        }
    }

    async function addStudent(event) {
        event.preventDefault();

        const username = document.getElementById('student_input').value.trim();
        const courseId = "<%= course_id %>";

        if (!username) {
            alert('Username required');
            return;
        }

        try {
            const res = await fetch('/instructor/add-student', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    username: username,
                    course_id: courseId
                })
            });
            console.log("Everything okay");
            if (!res.ok) {
                throw new Error('Request Failed');
            }
            
        } catch (err) {
            console.error(err);
            alert('Failed to add student');
        }
    }
</script>

</html>
