<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Course Details</title>
</head>

<body>
    <h1>Manage Course: <%=course_id%></h1>
    <a href="/instructor/dashboard">Back to Dashboard</a>

    <hr>
    <div id="error-box" style="display:none; color:red;"></div>
    <div id="warning-box" style="display:none; color:yellow;"></div>
    <!-- Add Student -->
    <h3>Add Student</h3>
    <form onsubmit="addStudent(event)">
        <label>Enter Student Username</label>
        <input type="text" id="student_input" required>
        <button type="submit">Add Student</button>
    </form>

    <hr>

    <!-- Enrolled Students -->
    <h3>Enrolled Students</h3>
    <ul>
        <% if (student_info.length === 0) { %>
            <li>No students enrolled.</li>
        <% } %>

        <% student_info.forEach(student => { %>
            <li>
                <%= student.student_id %>,
                <%= student.username %>,
                <%= student.full_name %>
                <button onclick="removeStudent('<%= student.student_id %>', '<%= course_id %>')">
                    Remove
                </button>
            </li>
        <% }) %>
    </ul>

</body>

<script>
    function showError(msg) {
        const box = document.getElementById('error-box');
        box.innerText = msg;
        box.style.display = 'block';
    }
    function showWarning(msg) {
        const box = document.getElementById('warning-box');
        box.innerText = msg;
        box.style.display = 'block';
    }
    async function removeStudent(student_id, courseId) {
        try {
            const res = await fetch('/instructor/remove-student', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    student_id: student_id,
                    course_id: courseId
                })
            });

            if (!res.ok) {
                const err = await res.json();
                showError(err.message);
                return;
            }

            location.reload();
        } catch (err) {
            console.error(err);
            showError('Network error');
        }
    }

    async function addStudent(event) {
        event.preventDefault();

        const username = document.getElementById('student_input').value.trim();
        const courseId = "<%= course_id %>";

        if (!username) {
            alert('Username required');
            return;
        }

        try {
            const res = await fetch('/instructor/add-student', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    username: username,
                    course_id: courseId
                })
            });
            
            if (!res.ok) {
                const err = await res.json();
                showError(err.message);
                return;
            }

            const data = await res.json();
            if (data.warning) {
                alert(data.warning);
            }
            
            location.reload();
        } catch (err) {
            console.error(err);
            showError('Network error');
        }
    }
</script>

</html>
