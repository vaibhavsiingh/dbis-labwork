<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Course Details</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
        }

        .container {
            width: 900px; 
            margin: 40px auto; 
            background: white;
            padding: 20px;
            border: 1px solid #ddd ;
           border-radius: 4px
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        th {
        background-color: #f0f0f0;
        }

        button {
            padding: 4px 8px;
            cursor: pointer;
        }

        #error-box {
            color: red;
            margin: 10px 0;
            display: none;
        }

        #warning-box {
            color: #b58900;
            margin: 10px 0;
            display: none;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Manage Course: <%= course_id %></h1>
        <a href="/instructor/dashboard">Back to Dashboard</a>

        <hr>

        <div id="error-box"></div>
        <div id="warning-box"></div>

        <h3>Add Student</h3>
        <form onsubmit="addStudent(event)">
            <label>Enter Student Username</label>
            <input type="text" id="student_input" required>
            <button type="submit">Add Student</button>
        </form>

        <hr>

        <h3>Enrolled Students</h3>

        <% if (student_info.length === 0) { %>
            <p>No students enrolled.</p>
        <% } else { %>
            <table>
                <tr>
                    <th>Student ID</th>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Action</th>
                </tr>
                <% student_info.forEach(student => { %>
                    <tr>
                        <td><%= student.student_id %></td>
                        <td><%= student.username %></td>
                        <td><%= student.full_name %></td>
                        <td>
                            <button onclick="removeStudent('<%= student.student_id %>', '<%= course_id %>')">
                                Remove
                            </button>
                        </td>
                    </tr>
                <% }) %>
            </table>
        <% } %>
    </div>
</body>

<script>
    function showError(msg) {
        const box = document.getElementById('error-box');
        box.innerText = msg;
        box.style.display = 'block';
    }
    function showWarning(msg) {
        const box = document.getElementById('warning-box');
        box.innerText = msg;
        box.style.display = 'block';
    }
    async function removeStudent(student_id, courseId) {
        try {
            const res = await fetch('/instructor/remove-student', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ student_id, course_id: courseId })
            });

            if (!res.ok) {
                const err = await res.json();
                showError(err.message);
                return;
            }
            location.reload();
        } catch (err) {
            console.error(err);
            showError('Network error');
        }
    }

    async function addStudent(event) {
        event.preventDefault();

        const username = document.getElementById('student_input').value.trim();
        const courseId = "<%= course_id %>";

        if (!username) {
            alert('Username required');
            return;
        }

        try {
            const res = await fetch('/instructor/add-student', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, course_id: courseId })
            });

            if (!res.ok) {
                const err = await res.json();
                showError(err.message);
                return;
            }

            const data = await res.json();
            if (data.warning) {
                sessionStorage.setItem("warningMessage", "Credit limit exhausted for the student. (Instructor Override)");
            }
            location.reload();
        } catch (err) {
            console.error(err);
            showError('Network error');
        }
    }

    window.onload = () => {
        const msg = sessionStorage.getItem("warningMessage");
        if (msg) {
            showWarning(msg);
            sessionStorage.removeItem("warningMessage");
        }
    };
</script>

</html>
