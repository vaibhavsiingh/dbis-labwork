<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Instructor Dashboard</title>
</head>

<body>
    <h1>Instructor Dashboard</h1>
    <a href="/logout">Logout</a>

    <hr>

    <!-- TODO: Display Courses Taught by Instructor -->

    <h2>My Courses</h2>
    <h4>Select a course to manage students </h4><br>
    <ul>
        <% courses.forEach(course =>{ %>
            <li><%= course.course_id %>, <%= course.course_name %>, <%= course.credits %>, <%= course.slot %>
                <button onclick="manageCourse('<%= course.course_id %>')">Manage</button>
            </li>
        <%})%>
    </ul>

    <!-- Link to Course Details page (/instructor/course/:id) -->

</body>

<script>
    async function manageCourse(courseId){
        try {
            const res = await fetch('/instructor/course/:id', {
                method:'GET',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({course_id: courseId})
            });
            
            if(!res.ok){
                throw new Error('Request Failed');
            }
            
            location.reload();
            // alert('Loading course info');
        } catch (err){
            console.error(err);
            alert('Failed to load course info');
        }
    }

</script>


</html>